# Copy to .env and fill in. Everything is optional: the app runs without Telegram or an LLM.

# Telegram (create a bot with @BotFather; get your numeric user id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# OpenRouter free models (https://openrouter.ai/keys). Only ":free" models are ever called.
OPENROUTER_API_KEY=
# Comma-separated, tried in order. The free list changes; edit freely.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free

# Optional overrides
# EPOCH_PORT=8765
# EPOCH_DATA_DIR=./data
# EPOCH_BACKUP_DIR=   (e.g. a folder inside iCloud Drive or Google Drive)
# EPOCH_LAN=1   (listen on the home network for the tablet; or use the Settings toggle)
# ACTIVITYWATCH_URL=http://localhost:5600
